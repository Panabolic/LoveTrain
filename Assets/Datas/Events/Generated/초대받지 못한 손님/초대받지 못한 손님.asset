  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc52c99cfa32c8b49a16d68e16abd314, type: 3}
  m_Name: "\uCD08\uB300\uBC1B\uC9C0 \uBABB\uD55C \uC190\uB2D8"
  m_EditorClassIdentifier: Assembly-CSharp::SO_Event
  EventTitle: "\uCD08\uB300\uBC1B\uC9C0 \uBABB\uD55C \uC190\uB2D8"
  titleKey: event.uninvited_guest.title
  EventText: "\uC5ED\uC5D0 \uB3C4\uCC29\uD558\uC790 \uCC28\uB2E8\uAE30\uAC00 \uB0B4\uB824\uC624\uACE0
    \uB3CC\uB85C\uB41C \uACE8\uB818\uC774 \uC55E\uC744 \uB9C9\uC544\uC120\uB2E4.\n\n\"\uC774
    \uC5ED\uC740 \uCD08\uB300\uBC1B\uC740 \uC190\uB2D8\uB9CC \uC9C0\uB098\uAC00\uC2E4
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCD08\uB300\uC99D\uC744 \uBCF4\uC5EC\uC8FC\uC2ED\uC2DC\uC624\"\n\n\uC5ED
    \uB4A4\uD3B8\uC5D0\uC11C \uB9E4\uCF00\uD55C \uC5F0\uAE30\uC640 \uD568\uAED8 \uBE44\uBA85\uC774
    \uB4E4\uB9B0\uB2E4. \uC5EC\uAE30\uB97C \uBE60\uC838\uB098\uAC00\uC9C0 \uBABB\uD55C\uB2E4\uBA74
    \uB098\uB3C4 \uAC19\uC740\uAF34\uC774 \uB418\uB294\uAC8C \uC544\uB2D0\uAE4C?"
  textKey: event.uninvited_guest.body
  Selections:
  - selectionText: "\uC870\uAE08 \uAD6C\uACA8\uC84C\uC9C0\uB9CC \uC5EC\uAE30 \uCD08\uB300\uC7A5\uC785\uB2C8\uB2E4"
    textId: choice_1
    selectionTextKey: event.uninvited_guest.choice_1.text
    selectionUnderText: "{speed_gain.chance}%로 속도 {speed_gain.amount}회복, {speed_loss.chance}%로 속도 {speed_loss.amount}감소"
    selectionUnderTextKey: event.uninvited_guest.choice_1.hint
    eventToTrigger: {fileID: 11400000, guid: ae335b3a1b2a1dd469755abec09a7239, type: 2}
  - selectionText: "\uC544. \uCC29\uBD88 \uD0DD\uBC30 \uBC30\uB2EC\uC654\uC2B5\uB2C8\uB2E4."
    textId: choice_2
    selectionTextKey: event.uninvited_guest.choice_2.text
    selectionUnderText: "{upgrade.chance}%로 보유 아이템 [{upgrade.count}]개 [{upgrade.levels}]업그레이드, {speed_loss.chance}%로 속도 {speed_loss.amount}감소"
    selectionUnderTextKey: event.uninvited_guest.choice_2.hint
    eventToTrigger: {fileID: 11400000, guid: dd6d85e845ec12a4f9772b55452b6129, type: 2}
