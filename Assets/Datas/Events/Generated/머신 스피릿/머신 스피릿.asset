  m_Script: {fileID: 11500000, guid: fc52c99cfa32c8b49a16d68e16abd314, type: 3}
  m_Name: "\uBA38\uC2E0 \uC2A4\uD53C\uB9BF"
  m_EditorClassIdentifier: Assembly-CSharp::SO_Event
  EventTitle: "\uBA38\uC2E0 \uC2A4\uD53C\uB9BF"
  titleKey: event.machine_spirit.title
  EventText: "\"\uC57C! \uAE30\uACC4\uB294 \uB450\uB4E4\uACA8 \uD328\uC11C \uC815\uC2E0\uC744
    \uCC28\uB9AC\uAC8C \uD574\uC57C\uC9C0! \uADF8\uAC8C '\uBA38\uC2E0 \uC2A4\uD53C\uB9BF'\uC774\uC57C!\"\r\n\r\n\"\uBB34\uC2DD\uD55C
    \uC18C\uB9AC! \uC815\uBC00\uD558\uAC8C \uB098\uC0AC\uB97C \uC870\uC5EC\uC57C\uC9C0,
    \uADF8\uB7EC\uB2E4 \uB2E4 \uBD80\uC11C\uC9C4\uB2E4\uACE0!\"\r\n\r\n\uAE30\uCC28\uC758
    \uC790\uCE6D \uCC9C\uC7AC \uC815\uBE44\uACF5 \uAE40\uC528\uC640 \uBC15\uC528\uAC00
    \uC0B0\uB354\uBBF8 \uAC19\uC740 \uACE0\uCCA0\uC744 \uB450\uACE0 \uB17C\uC7C1
    \uC911\uC774\uB2E4 \uAE40\uC528\uB294 \uD29C\uB2DD\uC740 '\uD55C\uBC29'\uC774\uB77C\uBA70
    \uAC70\uB300\uD55C \uB9DD\uCE58\uB97C \uB4E4\uACE0 \uC788\uACE0, \uBC15\uC528\uB294
    '\uC548\uC804\uC81C\uC77C'\uC774\uB77C\uBA70 \uC815\uBC00 \uB4DC\uB77C\uC774\uBC84\uB97C
    \uB4E4\uACE0 \uC788\uB2E4. \uB458 \uC911 \uD55C \uBA85\uC5D0\uAC8C \uAE30\uCC28
    \uC815\uBE44\uB97C \uB9E1\uACA8\uC57C \uD560 \uB4EF \uD558\uB2E4."
  textKey: event.machine_spirit.body
  Selections:
  - selectionText: "\uAE40\uC528\uC5D0\uAC8C \uB9E1\uAE34\uB2E4"
    textId: choice_1
    selectionTextKey: event.machine_spirit.choice_1.text
    selectionUnderText: "{upgrade.chance}% 확률로 보유 아이템 [{upgrade.count}]개 최대로 업그레이드"
    selectionUnderTextKey: event.machine_spirit.choice_1.hint
    eventToTrigger: {fileID: 11400000, guid: 7d4add2a74a075c418c5295e8e3c087c, type: 2}
  - selectionText: "\uBC15\uC528\uC5D0\uAC8C \uB9E1\uAE34\uB2E4"
    textId: choice_2
    selectionTextKey: event.machine_spirit.choice_2.text
    selectionUnderText: "{upgrade.chance}% 확률로 보유 아이템 [{upgrade.count}]개 [{upgrade.levels}]만큼 업그레이드"
    selectionUnderTextKey: event.machine_spirit.choice_2.hint
    eventToTrigger: {fileID: 11400000, guid: 3cc221346e70ac1468a485ae5b90baa9, type: 2}
  - selectionText: "\uCC28\uB77C\uB9AC \uB0B4\uAC00 \uC9C1\uC811\uD55C\uB2E4"
    textId: choice_3
    selectionTextKey: event.machine_spirit.choice_3.text
    selectionUnderText: "보유 아이템 [{upgrade.count}]개 [{upgrade.levels}]만큼 업그레이드"
    selectionUnderTextKey: event.machine_spirit.choice_3.hint
    eventToTrigger: {fileID: 11400000, guid: 8a9b0ac937f26b84cbe3c0bf82934421, type: 2}
