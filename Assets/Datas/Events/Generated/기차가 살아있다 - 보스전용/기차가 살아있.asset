  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc52c99cfa32c8b49a16d68e16abd314, type: 3}
  m_Name: "\uAE30\uCC28\uAC00 \uC0B4\uC544\uC788"
  m_EditorClassIdentifier: Assembly-CSharp::SO_Event
  EventTitle: "\uAE30\uCC28\uAC00 \uC0B4\uC544\uC788\uB2E4?!"
  titleKey: event.living_train_boss.title
  EventText: "요란한 폭발음과 함께 거대한몬스터가 사라지자 기차에서 방송음이 들려온다.\n\n “아아, 한군데도 멀쩡한 곳이 없네. 거 좀 살살 다루쇼”\n\n ”아니 근데 저것들 진짜 쓸만해 보이는데 빠르게 딱 하나만 주워갑시다.”"
  textKey: event.living_train_boss.body
  Selections:
  - selectionText: "\"저기 저 번쩍거리는거 하나 챙겨\""
    textId: choice_1
    selectionTextKey: event.living_train_boss.choice_1.text
    selectionUnderText: "랜덤 아이템 [{reward.count}]개 획득"
    selectionUnderTextKey: event.living_train_boss.choice_1.hint
    eventToTrigger: {fileID: 11400000, guid: 37fd27338d70ac941931f0e36580b06e, type: 2}
  - selectionText: "\"\uAC70\uAE30 \uB098\uC0AC\uB098 \uAF49 \uC870\uC5EC \uBB54
      \uC0C8\uAC70\uC57C\""
    textId: choice_2
    selectionTextKey: event.living_train_boss.choice_2.text
    selectionUnderText: "보유한 아이템 [{upgrade.count}]개 [{upgrade.levels}]업그레이드"
    selectionUnderTextKey: event.living_train_boss.choice_2.hint
    eventToTrigger: {fileID: 11400000, guid: 033abfe1ddddb5f49aa03d7961e52907, type: 2}
  - selectionText: "\"\uD37C\uC9C0\uAE30 \uC77C\uBCF4 \uC9C1\uC804\uC774\uC57C, \uAE30\uB984\uCE60\uC774\uB098
      \uD574!\""
    textId: choice_3
    selectionTextKey: event.living_train_boss.choice_3.text
    selectionUnderText: "속도 {speed_gain.amount}회복"
    selectionUnderTextKey: event.living_train_boss.choice_3.hint
    eventToTrigger: {fileID: 11400000, guid: be7e5c3fbc383b349993211e78a6701c, type: 2}
